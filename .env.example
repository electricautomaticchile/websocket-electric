# Puerto HTTP/WS del servicio (ALB enruta /ws aquí)
PORT=8081

# Clave JWT — DEBE ser idéntica a la JWT_SECRET de la API
JWT_SECRET=tu_secret_key_aqui_minimo_32_caracteres

# Redis (bus de eventos Pub/Sub). Usar REDIS_URL o los campos individuales.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Orígenes permitidos para el handshake WebSocket (mismos que la API)
CORS_ORIGINS=http://localhost:3000,http://localhost:3005,https://electricautomaticchile.com

# Entorno
NODE_ENV=development
